@page "/"
@using LandRegistry.Web.Models
@using Microsoft.AspNetCore.Components.Forms

<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">🗺️ Land Registry Nepal</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="#register">Register Land</a></li>
                <li class="nav-item"><a class="nav-link" href="#transfer">Transfer Ownership</a></li>
                <li class="nav-item"><a class="nav-link" href="#history">View History</a></li>
                <li class="nav-item"><a class="nav-link" href="#contract">Smart Contract</a></li>
                <li class="nav-item"><a class="nav-link" href="#chatbot">AI Chatbot</a></li>
            </ul>
        </div>
    </div>
</nav>

<header class="bg-light text-center p-5">
    <h1 class="display-5">Welcome to Nepal's Land Registration System</h1>
    <p class="lead">Blockchain-Powered | Transparent | Secure</p>
</header>

<!-- Register Land -->
<section class="container my-5" id="register">
    <h2>📌 Land Registration</h2>
    <EditForm Model="@newLand" OnValidSubmit="@RegisterLand">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="landIdReg" class="form-label">Land ID</label>
            <InputText class="form-control" id="landIdReg" @bind-Value="registerLandId" />
        </div>
        <div class="mb-3">
            <label for="ownerName" class="form-label">Owner Name</label>
            <InputText class="form-control" id="ownerName" @bind-Value="newLand.OwnerName" />
        </div>
        <div class="mb-3">
            <label for="ownerAddr" class="form-label">Owner Address (Sui)</label>
            <InputText class="form-control" id="ownerAddr" @bind-Value="registerOwnerAddress" />
        </div>
        <div class="mb-3">
            <label for="landLocation" class="form-label">Land Location</label>
            <InputText class="form-control" id="landLocation" @bind-Value="newLand.Location" />
        </div>
        <div class="mb-3">
            <label for="area" class="form-label">Area (in Ropani)</label>
            <InputNumber class="form-control" id="area" @bind-Value="newLand.Area" />
        </div>
        <button type="submit" class="btn btn-success">Register Land</button>
        @if (!string.IsNullOrWhiteSpace(registerTxDigest))
        {
            <div class="alert alert-success mt-3">Transaction: @registerTxDigest</div>
        }
        @if (!string.IsNullOrWhiteSpace(registerError))
        {
            <div class="alert alert-danger mt-3">@registerError</div>
        }
        @if (!string.IsNullOrWhiteSpace(registerRawOutput))
        {
            <pre class="mt-3" style="white-space:pre-wrap">@registerRawOutput</pre>
        }
    </EditForm>
</section>

<!-- Transfer Ownership -->
<section class="container my-5" id="transfer">
    <h2>🔁 Transfer Ownership</h2>
    <EditForm Model="@transferModel" OnValidSubmit="@TransferOwnership">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="landId" class="form-label">Land ID</label>
            <InputText class="form-control" id="landId" @bind-Value="transferModel.LandId" />
        </div>
        <div class="mb-3">
            <label for="newOwner" class="form-label">New Owner Name</label>
            <InputText class="form-control" id="newOwner" @bind-Value="transferModel.NewOwnerName" />
        </div>
        <button type="submit" class="btn btn-warning">Transfer</button>
    </EditForm>
</section>

<!-- Land History Viewer -->
<section class="container my-5" id="history">
    <h2>📜 Land History Viewer</h2>
    <EditForm Model="@historyModel" OnValidSubmit="@FetchHistory">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mb-3">
            <label for="historyLandId" class="form-label">Enter Land ID</label>
            <InputText class="form-control" id="historyLandId" @bind-Value="historyModel.LandId" />
        </div>
        <button type="submit" class="btn btn-info">Fetch History</button>
    </EditForm>
    <div class="mt-3" id="historyResults">
        @if (historyResults != null)
        {
            <ul>
                @foreach (var record in historyResults)
                {
                    <li>@record.OwnerName owned land at @record.Location (Area: @record.Area)</li>
                }
            </ul>
        }
    </div>
</section>

<!-- Smart Contract Interaction -->
<section class="container my-5" id="contract">
    <h2>💡 Smart Contract Interaction</h2>
    <button class="btn btn-outline-dark" @onclick="MintLandToken">🔗 Mint Land Token</button>
    <button class="btn btn-outline-secondary" @onclick="VerifyOwnership">🚀 Verify Ownership</button>
    <button class="btn btn-outline-success" @onclick="SubmitToBlockchain">📤 Submit to Blockchain</button>
</section>

<!-- AI Chatbot -->
<section class="container my-5" id="chatbot">
    <h2>🤖 AI Chatbot Assistant</h2>
    <p>Need help? Use the chatbot below to ask any question about the system.</p>
    <div class="chatbot-box">
        <iframe src="https://example-chatbot.com/embed" title="AI Bot"></iframe>
    </div>
</section>

<footer class="text-center p-4 bg-light mt-5">
    <small>© 2025 Government of Nepal – Land Registration Blockchain System</small>
</footer>

<script src="js/land.js"></script>

@code {
    [Inject] private IJSRuntime? JS { get; set; }
    [Inject] private IHttpClientFactory? ClientFactory { get; set; }

    LandRecord newLand = new LandRecord();
    string registerLandId = string.Empty;
    string registerOwnerAddress = string.Empty;
    string? registerTxDigest;
    string? registerError;
    string? registerRawOutput;
    TransferModel transferModel = new TransferModel();
    HistoryModel historyModel = new HistoryModel();
    List<LandRecord>? historyResults;

    // Sui smart contract parameters (replace with actual values after deployment)
    private string PackageId = "0x69373aab510d125280e775c4c99a826bf6b7be29a98747a9e8c95ebc5fbf4ad2";
    private string Module = "land_registry";
    private string AdminCapId = "0x3ab049e510886e46608305a605de10f6c541d60b5194e4c43494947e50cc0630";

    private HttpClient Http => ClientFactory != null
        ? ClientFactory.CreateClient("ApiClient")
        : throw new InvalidOperationException("ClientFactory is not initialized.");

    // Now you can use relative URLs like "api/land/register"
    private async Task RegisterLand()
    {
        registerTxDigest = null;
        registerError = null;
        registerRawOutput = null;

        // Build the DTO the API expects
        var payload = new
        {
            LandId = registerLandId,
            OwnerAddress = registerOwnerAddress,
            Location = newLand.Location,
            AreaRopani = (ulong)Math.Max(0, Math.Round(newLand.Area))
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/land/register", payload);
            var body = await response.Content.ReadFromJsonAsync<ResponseDto>();

            if (response.IsSuccessStatusCode && body?.TransactionHash is string digest && !string.IsNullOrWhiteSpace(digest))
            {
                registerTxDigest = digest;
                registerRawOutput = body?.Output;
            }
            else
            {
                registerError = body?.Error ?? $"Registration failed (HTTP {(int)response.StatusCode}).";
                registerRawOutput = body?.Output;
            }
        }
        catch (Exception ex)
        {
            registerError = ex.Message;
        }
    }

    private Task TransferOwnership()
    {
        // Example: save off-chain via API
        // await Api.TransferOwnership(transferModel.LandId, transferModel.NewOwnerName);
        return Task.CompletedTask;
    }

    private Task FetchHistory()
    {
        // Example: fetch off-chain history
        // historyResults = await Api.GetHistory(historyModel.LandId);
        return Task.CompletedTask;
    }

    // === Blockchain functions via JSInterop ===
    private async Task MintLandToken()
    {
        if (JS is not null)
        {
            await JS.InvokeVoidAsync("mintLandToken", PackageId, Module, AdminCapId);
        }
        else
        {
            Console.WriteLine("JSRuntime is not initialized.");
        }
    }

    private async Task SubmitToBlockchain()
    {
        if (JS is not null)
        {
            await JS.InvokeVoidAsync("submitToBlockchain", PackageId, Module);
        }
        else
        {
            Console.WriteLine("JSRuntime is not initialized.");
        }
    }

    private async Task VerifyOwnership()
    {
        if (JS is not null)
        {
            await JS.InvokeVoidAsync("verifyOwnership", PackageId, Module);
        }
        else
        {
            Console.WriteLine("JSRuntime is not initialized.");
        }
    }

    public class TransferModel
    {
        public string LandId { get; set; } = string.Empty;
        public string NewOwnerName { get; set; } = string.Empty;
    }

    public class HistoryModel
    {
        public string LandId { get; set; } = string.Empty;
    }

    public class ResponseDto
    {
        public string? TransactionHash { get; set; }
        public string? Output { get; set; }
        public string? Error { get; set; }
    }
}
